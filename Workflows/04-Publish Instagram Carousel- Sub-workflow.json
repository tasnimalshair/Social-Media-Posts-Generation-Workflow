  "name": "Publish Instagram Carousel- Sub-workflow",
  "nodes": [
    {
      "parameters": {
        "jsCode": "// كل الـ items الجاية للـ node (البيانات الأصلية اللي فيها الروابط المكررة)\nconst items = $input.all();\n\n// نربط كل رابط بالـ id الفريد تبعه، ونعمل dedupe بنفس الوقت\nconst urlToId = new Map();\nfor (const item of items) {\n  const url = item.json.image_url;\n  if (!urlToId.has(url)) {\n    urlToId.set(url, item.json.id);\n  }\n}\n\n// نرجع item منفصل لكل رابط، مع الـ id الفريد تبعه\nreturn Array.from(urlToId.entries()).map(([url, id]) => ({\n  json: {\n    id: id,\n    url: url\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
