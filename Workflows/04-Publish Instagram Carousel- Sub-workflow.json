      "parameters": {
        "jsCode": "const items = $input.all();\n\n// رتّبي حسب slide_number قبل أي شي\nconst sortedItems = items.sort((a, b) => a.json.slide_number - b.json.slide_number);\n\nconst creationIds = sortedItems.map(item => item.json.creation_id);\n\nreturn [\n  {\n    json: {\n      creation_ids: creationIds\n    }\n  }\n];"
      },
