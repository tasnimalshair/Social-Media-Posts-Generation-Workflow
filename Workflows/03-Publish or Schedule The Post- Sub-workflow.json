        "jsCode": "const userInput = $input.first().json.data.text;\n\n// نحاول نحوّل النص لتاريخ\nconst parsedDate = new Date(userInput.trim().replace(' ', 'T') + ':00');\n\nlet isValid = true;\nlet errorType = null;\nlet errorMessage = null;\n\nif (isNaN(parsedDate.getTime())) {\n  isValid = false;\n  errorType = 'bad_format';\n  errorMessage = '⚠️ Invalid format. Please send the date and time exactly in this format:\\nYYYY-MM-DD HH:mm\\nExample: 2026-09-20 18:00';\n} else if (parsedDate < new Date()) {\n  isValid = false;\n  errorType = 'past_date';\n  errorMessage = '⚠️ The date you sent is in the past. Please send a future date and time.';\n}\n\nreturn [\n  {\n    json: {\n      isValid: isValid,\n      errorType: errorType,\n      errorMessage: errorMessage,\n      scheduledTime: isValid ? parsedDate.toISOString() : null\n    }\n  }\n];"
      },
