    {
      "parameters": {
        "jsCode": "const message = $json.callback_query.message.text;\n\n\n// Extract sections\nfunction extractBetween(text, start, end) {\n  const startIndex = text.indexOf(start);\n  const endIndex = end ? text.indexOf(end) : text.length;\n\n  if (startIndex === -1) return \"\";\n\n  return text\n    .substring(\n      startIndex + start.length,\n      endIndex === -1 ? text.length : endIndex\n    )\n    .trim();\n}\n\n\n// Get Carousel section\nconst carousel = extractBetween(\n  message,\n  \"🎨 Carousel Slides\",\n  null\n);\n\n\n// Split slides\nconst slides = carousel\n  .split(\"━━━━━━━━━━━━━━━━━━\")\n  .map(s => s.trim())\n  .filter(Boolean);\n\n\n// Extract slide data\nfunction extractSlide(slide) {\n\n  const lines = slide\n    .split(\"\\n\")\n    .map(line => line.trim())\n    .filter(Boolean);\n\n\n  // Remove slide label\n  lines.shift();\n\n\n  return {\n    title: lines[0] || \"\",\n    body: lines.slice(1).join(\" \")\n  };\n}\n\n\nconst slide1 = extractSlide(slides[0]);\nconst slide2 = extractSlide(slides[1]);\nconst slide3 = extractSlide(slides[2]);\nconst slide4 = extractSlide(slides[3]);\nconst slide5 = extractSlide(slides[4]);\n\n\n// Return clean design JSON\n\nreturn [\n  {\n    json: {\n    post_id: $input.first().json.callback_query.data.split(\"_\")[1],\n      hook: slide1.title,\n\n      title_1: slide2.title,\n      body_1: slide2.body,\n\n      title_2: slide3.title,\n      body_2: slide3.body,\n\n      title_3: slide4.title,\n      body_3: slide4.body,\n\n      title_4: slide5.title,\n      body_4: slide5.body\n\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -160,
